{
  "name": "djscord-music-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord music bot MVP powered by Lavalink",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "commands:deploy": "tsx src/deploy-commands.ts",
    "commands:deploy:prod": "node dist/deploy-commands.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "lavalink-client": "^2.10.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
