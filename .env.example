DISCORD_TOKEN=replace-with-your-discord-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id
# DATABASE_PATH=/data/djscord.sqlite
# KOFI_URL=https://ko-fi.com/replace-with-your-id
# LASTFM_API_KEY=replace-with-your-lastfm-api-key
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace-with-a-long-random-password

# DJ Engine은 선택 기능입니다. compose.djengine.yaml을 사용할 때 네 값을 설정하세요.
# DJENGINE_API_KEY=replace-with-at-least-32-random-bytes
# DJENGINE_BASE_URL=http://engine:8787
# DJENGINE_HOST_MUSIC_ROOT=/absolute/path/to/your/music
# DJENGINE_HOST_REKORDBOX_XML=/absolute/path/to/rekordbox.xml
# MIX_INGEST_URL=https://your-site.example/api/internal/v1
# MIX_INGEST_SECRET=replace-with-at-least-32-random-bytes
# MIX_PUBLIC_URL=https://your-site.example/mix
